    "name": "dawidmachon",
    "email": "ja@machon.net",
    "url": "https://github.com/dawidmachon"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidmachon/pi-peak-hours-footer.git"
  },
  "homepage": "https://github.com/dawidmachon/pi-peak-hours-footer#readme",
  "bugs": {
    "url": "https://github.com/dawidmachon/pi-peak-hours-footer/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "peak-hours.example.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
